#!/bin/bash

# omarchy:summary=Report whether Freearchy-nightly has new commits on the fork

fork="https://github.com/CharmedPlutonia/omachry-freearchy-testing.git"
branch="freearchy-nightly"

git -C "$OMARCHY_PATH" remote set-url origin "$fork"
if ! git -C "$OMARCHY_PATH" fetch --quiet origin "$branch"; then
  echo "Error: Could not reach the Freearchy-nightly fork."
  exit 1
fi

local_rev=$(git -C "$OMARCHY_PATH" rev-parse HEAD)
remote_rev=$(git -C "$OMARCHY_PATH" rev-parse "origin/$branch")

if [[ $local_rev != $remote_rev ]]; then
  echo "Freearchy-nightly update available"
  exit 0
fi

echo "Freearchy-nightly is up to date"
exit 1
