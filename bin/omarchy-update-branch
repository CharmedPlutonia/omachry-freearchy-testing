#!/bin/bash

# omarchy:summary=Update Freearchy-nightly. Other branches are refused.
# omarchy:args=<freearchy-nightly>

set -e

branch="${1:-freearchy-nightly}"

if [[ $branch != "freearchy-nightly" && $branch != "nightly" ]]; then
  echo "Error: Refusing to update from '$branch'."
  exit 1
fi

omarchy-snapshot create || (( $? == 127 ))
omarchy-channel-set nightly
