#!/bin/bash

# omarchy:summary=Freearchy-nightly only tracks its own branch
# omarchy:args=<freearchy-nightly>

branch="${1:-freearchy-nightly}"

if [[ $branch != "freearchy-nightly" && $branch != "nightly" ]]; then
  echo "Error: Refusing to switch to '$branch'. Freearchy-nightly does not track upstream Omarchy branches."
  exit 1
fi

git -C "$OMARCHY_PATH" fetch origin freearchy-nightly
git -C "$OMARCHY_PATH" switch -C freearchy-nightly origin/freearchy-nightly
