#!/bin/bash

# omarchy:summary=Stay on Freearchy-nightly. Upstream Omarchy channels are disabled.
# omarchy:args=<nightly>
# omarchy:requires-sudo=true

if [[ ${1:-nightly} != "nightly" && ${1:-} != "freearchy-nightly" ]]; then
  echo "Freearchy-nightly does not follow Omarchy stable, rc, edge, or dev."
  echo "Those channels would pull Omarchy 4.x. Staying on freearchy-nightly."
fi

git -C "$OMARCHY_PATH" remote set-url origin https://github.com/CharmedPlutonia/omachry-freearchy-testing.git
git -C "$OMARCHY_PATH" fetch origin freearchy-nightly
git -C "$OMARCHY_PATH" checkout -B freearchy-nightly origin/freearchy-nightly

omarchy-refresh-pacman
omarchy-update -y
