#!/bin/bash

# omarchy:summary=Reinstall the Freearchy-nightly source directory from git

set -e

git clone --depth=1 --branch freearchy-nightly "https://github.com/CharmedPlutonia/omachry-freearchy-testing.git" ~/.local/share/omarchy-new >/dev/null
mv $OMARCHY_PATH ~/.local/share/omarchy-old
mv ~/.local/share/omarchy-new $OMARCHY_PATH
